{
  "name": "popup-header",
  "description": "right-click while the buds' place is known: the menu opens under a picture of the case and buds as they are (line art in the menu's colours) and the Left, Right and Case levels; without it the menu is as before",
  "options": { "connected": true },
  "region": "1080,560,840,520",
  "steps": [
    { "wait": 500 },
    { "rightClick": "icon" },
    { "wait": 300 },
    { "waitFor": "s.shell.menu && !s.shell.menu[0].items[0].endsWith('(picture)')", "timeout": 100, "label": "no header while the buds' place is unknown" },
    { "key": "Escape" },
    { "bt": ["setBattery", "AirPods Pro", { "left": 80, "right": 70, "case": 50, "caseCharging": true }] },
    { "bt": ["setPods", "AirPods Pro", { "state": "left out", "inEar": true }] },
    { "wait": 700 },
    { "rightClick": "icon" },
    { "wait": 300 },
    { "waitFor": "s.shell.menu[0].items[0].endsWith('(picture)') && s.app.pods === 'left out'", "timeout": 100, "label": "the picture header" },
    { "shot": "menu-left-out" },
    { "key": "Escape" },
    { "bt": ["setPods", "AirPods Pro", { "state": "lid open" }] },
    { "wait": 700 },
    { "rightClick": "icon" },
    { "wait": 300 },
    { "shot": "menu-lid-open" },
    { "key": "Escape" },
    { "bt": ["setPods", "AirPods Pro", { "state": "out", "inEar": true }] },
    { "wait": 700 },
    { "rightClick": "icon" },
    { "wait": 300 },
    { "shot": "menu-both-out" },
    { "key": "Escape" },
    { "bt": ["setPods", "AirPods Pro", { "state": "closed" }] },
    { "wait": 700 },
    { "rightClick": "icon" },
    { "wait": 300 },
    { "shot": "menu-closed" },
    { "key": "Escape" }
  ]
}
