{
  "name": "case-icon",
  "description": "the tray icon shows where the buds are: the closed case, the lid swinging open with the buds inside, one bud out (the case flows down, the buds stay), both out (the plain icon); each change eases over 0.52 s",
  "options": { "connected": true },
  "region": "icon",
  "zoom": 8,
  "steps": [
    { "wait": 500 },
    { "move": "200,200" },
    { "expect": { "app.icon": { "kind": "static", "state": "connected" }, "app.watching": true } },
    { "bt": ["setPods", "AirPods Pro", { "state": "closed" }] },
    { "expect": { "app.icon.kind": "case", "app.icon.pods": "closed" } },
    { "wait": 600 },
    { "expect": { "app.icon": { "kind": "case", "pods": "closed", "t": 1 } } },
    { "shot": "closed" },
    { "bt": ["setPods", "AirPods Pro", { "state": "lid open" }] },
    { "wait": 250 },
    { "shot": "opening" },
    { "wait": 350 },
    { "expect": { "app.icon": { "kind": "case", "pods": "lid open", "t": 1 } } },
    { "shot": "lid-open" },
    { "bt": ["setPods", "AirPods Pro", { "state": "left out", "inEar": true }] },
    { "wait": 250 },
    { "shot": "case-flowing-down" },
    { "wait": 350 },
    { "shot": "left-out" },
    { "bt": ["setPods", "AirPods Pro", { "state": "out", "inEar": true }] },
    { "wait": 600 },
    { "expect": { "app.icon": { "kind": "static", "state": "connected" } } },
    { "shot": "both-out" },
    { "bt": ["setPods", "AirPods Pro", { "state": "right out" }] },
    { "wait": 600 },
    { "shot": "right-out" },
    { "bt": ["externalDisconnect", "AirPods Pro"] },
    { "bt": ["setPods", "AirPods Pro", { "state": "lid open" }] },
    { "waitFor": "s.app.icon.state === undefined && s.app.target && !s.app.target.connected", "timeout": 3000 },
    { "wait": 600 },
    { "shot": "lid-open-not-connected" }
  ]
}
