{
  "name": "header-anim",
  "description": "the menu's picture header moves with the buds while the menu is open (design 2): the lid swings open, the left bud hops out, then the right one, both bob, they go back and the lid snaps shut with a bump and an amber blink; nothing is redrawn once it's still",
  "options": { "connected": true },
  "region": "1080,560,840,520",
  "steps": [
    { "bt": ["setPods", "AirPods Pro", { "state": "closed" }] },
    { "wait": 1500 },
    { "rightClick": "icon" },
    { "wait": 400 },
    { "shot": "closed" },
    { "bt": ["setPods", "AirPods Pro", { "state": "lid open" }] },
    { "wait": 190 },
    { "shot": "lid-swinging" },
    { "wait": 800 },
    { "bt": ["setPods", "AirPods Pro", { "state": "left out", "inEar": true }] },
    { "wait": 400 },
    { "shot": "left-hopping" },
    { "wait": 1400 },
    { "shot": "left-out" },
    { "bt": ["setPods", "AirPods Pro", { "state": "out", "inEar": true }] },
    { "wait": 2500 },
    { "shot": "both-out" },
    { "waitFor": "s.shell.menuHeaderFrames > 20", "timeout": 100, "label": "the header moved" },
    { "bt": ["setPods", "AirPods Pro", { "state": "closed" }] },
    { "wait": 3000 },
    { "shot": "back-closed" },
    { "wait": 6000 },
    { "expect": { "shell.menuHeaderFrames": 73 } },
    { "wait": 2000 },
    { "expect": { "shell.menuHeaderFrames": 73 }, "label": "still: no more redraws" },
    { "key": "Escape" },
    { "expect": { "shell.menu": null } }
  ]
}
